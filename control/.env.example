# Control plane — Keel's own service. Never a tenant's.
PORT=9000

# The control database. Tenant databases (t_<slug>) live on the same server in
# the first deployment; TENANT_MONGO_URI is what changes the day they move.
MONGO_URI=mongodb://localhost:27017
MONGO_DB=keel_control
TENANT_MONGO_URI=

# Must be different from the tenant app's secret: a dashboard token and a
# restaurant admin token should never be interchangeable.
JWT_SECRET=change-me

# Created only when no dashboard account exists yet. Changing these later does
# not reset the password — use them once, then change it in the dashboard.
ADMIN_USERNAME=keel
ADMIN_PASSWORD=change-me

# The keel.uz site, for CORS in development. In production Caddy serves both
# under one host and this is not used.
CORS_ORIGINS=http://localhost:3100

# Every tenant gets <slug>.BASE_DOMAIN for free.
BASE_DOMAIN=keel.uz

# IndexNow — Yandex va Bingga sahifalarni "itarib" yuborish kaliti.
#
# ⚠️ Bo'sh bo'lsa konsoldagi tugma **rad etadi**, jimgina o'tkazib yubormaydi.
# Ixtiyoriy 8–128 belgili hex satr; **keel-site ham xuddi shu qiymatni olishi
# shart** — u kalitni /indexnow.txt da ko'rsatadi va IndexNow egalikni aynan
# shu fayl orqali tekshiradi. Ikkisi mos kelmasa har yuborish 403 bo'ladi.
# Google bu protokolda qatnashmaydi — u sitemapni o'zi o'qiydi.
INDEXNOW_KEY=

# So'm per order, for tenants created without an explicit price. Stored per
# tenant so an early customer's price survives a later rise.
PRICE_PER_ORDER=800

# The volume ladder: "upTo:price" bands, last one upTo 0 = no limit. Read as
# "whichever band is cheapest" — a band may be bought early at its full order
# count (models.PriceForOrders).
PRICE_TIERS=3000:800,15000:560,50000:400,0:300

# The least a period that had orders is billed, in so'm. 0 = off (default):
# a floor changes what customers owe and must be an explicit decision. A period
# with no orders is never charged. Per-customer floors override this.
MIN_MONTHLY=0

TRIAL_DAYS=14

# Attendance and invoices are filed by local calendar day.
TZ=Asia/Tashkent

# ---- Provisioning (S2) ----
#
# Empty DOCKER_SOCKET or CADDY_ADMIN switches the matching half off: tenants
# are still recorded, they are just not started. That is the mode a laptop
# runs in, and it must not be an error.
DOCKER_SOCKET=/var/run/docker.sock
TENANT_IMAGE=keel-tenant:latest
DOCKER_NETWORK=keel
# What a tenant container uses to reach Mongo — a name on that network, not
# this service's own URI.
TENANT_MONGO_HOST=mongodb://mongo:27017
UPLOADS_ROOT=/srv/keel/tenants

CADDY_ADMIN=http://caddy:2019
CADDY_EMAIL=hello@keel.uz
# Bitta manzil yoki vergul bilan ajratilgan ro'yxat (uch nusxa uchun):
# FRONTEND_HOST=keel-frontend-1:3000,keel-frontend-2:3000,keel-frontend-3:3000
FRONTEND_HOST=keel-frontend:3000
CONTROL_HOST=keel-control:9000
MAIN_UPSTREAM=keel-site:3100

# Passed through to every tenant container unchanged.
SMS_PROVIDER=demo
SMS_FROM=4546
ESKIZ_EMAIL=
ESKIZ_PASSWORD=
MAP_API_KEY=
