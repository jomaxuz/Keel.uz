#!/usr/bin/env bash
# Keel's deploy, and the only thing the CI key is allowed to run.
#
# GitHub Actions connects with a key pinned to this script (`command="..."` in
# authorized_keys) and passes its **temporary** GITHUB_TOKEN as the SSH command.
# Nothing long-lived is stored on this server: the token dies with the workflow
# run, and a leaked CI key can do exactly one thing — redeploy.
set -euo pipefail

REPO=/opt/keel
REMOTE=https://github.com/jomaxuz/Keel.uz.git
BRANCH=main
COMPOSE=(docker compose -f docker-compose.saas.yml)

# Only one deploy at a time.
#
# Two overlapping runs collide on container names: compose renames a container
# before replacing it, and the second run finds the temporary name taken. That
# happened once — a manual deploy and a CI deploy a few seconds apart — and it
# left the stack half-recreated, with new images built and old containers still
# serving. The CI workflow already serialises itself; this covers everything
# else, including a human in a hurry.
#
# ⚠️ **A fixed path, not $HOME.** The lock used to live in the caller's home
# directory, which meant it locked *the user* rather than the server: CI runs as
# `deploy-keel` and a person debugging runs as `root`, so the two took different
# files and neither ever saw the other. Both locks were sitting on the box, each
# perfectly held, protecting nothing — and the one collision this exists to
# prevent is exactly a human deploying while CI does. It reads as working right
# up until the day it matters, because a lock nobody contends looks identical to
# a lock that works.
#
# Inside the repository rather than /run/lock: that directory is world-writable,
# and only the two identities allowed to deploy can write here.
exec 9>"/opt/keel/.deploy.lock"
if ! flock -n 9; then
	echo "keel-deploy: boshqa deploy ketmoqda — to'xtatildi" >&2
	exit 1
fi

TOKEN="${SSH_ORIGINAL_COMMAND:-}"

# Whatever arrives is about to be used as a password.
#
# Checked for the two things that cannot change rather than for a format that
# keeps changing: it must be one word (no whitespace, so it cannot be a shell
# fragment) and long enough not to be a stray argument. Pinning the prefix
# refused the first real deploy; pinning a maximum length refused the second,
# because GitHub's token had grown to 377 characters. There is no upper bound
# here on purpose — the token never reaches a shell, it goes to an askpass
# helper, so its length protects nothing.
if [[ -z "$TOKEN" || "$TOKEN" =~ [[:space:]] || "${#TOKEN}" -lt 20 ]]; then
	# The value never appears; its shape is enough to tell "empty" from
	# "unexpected format" without putting a credential in a CI log.
	echo "keel-deploy: token qabul qilinmadi — uzunligi ${#TOKEN}, prefiksi '${TOKEN%%_*}'" >&2
	exit 1
fi

echo "==> kodni yangilash"
cd "$REPO"

# The token goes through an askpass helper rather than into the URL: an URL is
# visible in `ps` to every account on the box for as long as git runs.
ASKPASS=$(mktemp)
chmod 700 "$ASKPASS"
cat > "$ASKPASS" <<'EOS'
#!/bin/sh
case "$1" in
	Username*) echo "x-access-token" ;;
	*) echo "$KEEL_TOKEN" ;;
esac
EOS
trap 'rm -f "$ASKPASS"' EXIT
export KEEL_TOKEN="$TOKEN" GIT_ASKPASS="$ASKPASS" GIT_TERMINAL_PROMPT=0

before=$(git rev-parse HEAD)
git fetch --quiet "$REMOTE" "$BRANCH"
# reset rather than merge: this checkout is a deployment artefact, not
# somewhere anybody edits. A merge conflict here would stop a deploy at 2am
# over a file nobody meant to change.
git reset --hard --quiet FETCH_HEAD
after=$(git rev-parse HEAD)
rm -f "$ASKPASS"
unset KEEL_TOKEN GIT_ASKPASS

echo "    $before -> $after"
git --no-pager log --oneline -1

# ⚠️ This script deploys everything except itself.
#
# It is installed at /usr/local/bin/keel-deploy as the CI key's forced command
# (`command="..."` in authorized_keys); the copy in the repository is only the
# source of truth. So a fix committed here changes nothing on the server until
# somebody installs it — and the symptom is a deploy that keeps failing in a
# way the committed script no longer fails in, which reads as "the fix did not
# work" rather than "the fix is not there". That happened once, and the only
# clue was a wording difference in one echo.
#
# Warned rather than self-installed: this file is running, and bash reads a
# script as it goes. Overwriting it mid-run is a corrupted deploy, and a bad
# version of it locks the CI key out of the only thing it is allowed to do.
if [ -f "$REPO/deploy/keel-deploy" ] && ! cmp -s "$REPO/deploy/keel-deploy" "${BASH_SOURCE[0]}"; then
	echo "    ⚠️  o'rnatilgan deploy skripti eskirgan — quyidagini bir marta bajaring:" >&2
	echo "        sudo install -m 0755 $REPO/deploy/keel-deploy ${BASH_SOURCE[0]}" >&2
fi

echo "==> mijoz image'i"
# Built but never started here — the control plane starts one per customer.
"${COMPOSE[@]}" --profile tenant build

# Leftovers from a run that died between "rename the old one" and "start the
# new one". They are dead by definition — the live containers never carry this
# prefix — and the next deploy collides on the name until they are gone.
stale=$(docker ps -a --format '{{.Names}}' | grep -E '^[0-9a-f]{12}_keel-' || true)
if [ -n "$stale" ]; then
	echo "==> qolib ketgan konteynerlar tozalanmoqda"
	echo "$stale" | sed 's/^/    /'
	echo "$stale" | xargs -r docker rm -f >/dev/null
fi

echo "==> ishga tushirish"
"${COMPOSE[@]}" up -d --build

# And then recreate the three we build, explicitly.
#
# Compose is supposed to notice a rebuilt image and replace the container. It
# did not: after a deploy the tag pointed at one image, the container ran a
# second, and compose's own label recorded a third. The result was the worst
# kind of green deploy — right commit, healthy containers, new code never
# running, and the only symptom a missing route in a generated config.
#
# Every build produces a new image ID anyway (Go and Next builds are not
# reproducible), so "only if changed" would be true every time regardless.
# Asking directly is shorter than a heuristic that has already been wrong.
#
# `--no-deps` keeps mongo and caddy out of it: mongo holds every database on
# this host, and restarting caddy drops the edge back to its bootstrap config
# until the control plane syncs again.
echo "==> ilova xizmatlarini almashtirish"
# ⚠️ `pagecache` ham shu ro'yxatda, garchi u qurilmasa ham.
#
# Uning konfiguratsiyasi bind-mount qilingan fayl (`caddy/pagecache.conf`), ya'ni
# xizmat ta'rifi o'zgarmaydi va `up -d` konteynerni almashtirishga sabab
# ko'rmaydi — nginx esa eski konfiguratsiya bilan ishlab turadi. Bu repodagi eng
# qimmat tuzoqning aynan o'zi: commit to'g'ri, konteyner sog'lom, yangi qoida
# ishlamayapti.
"${COMPOSE[@]}" up -d --force-recreate --no-deps control site frontend pagecache

echo "==> tekshiruv"
# "Started" is not "working": a container whose Mongo is unreachable stays up
# for the whole connection timeout. The control plane's own health endpoint is
# the first honest signal, and keel.uz answering is the second.
# Both get the same patience, and that is the point.
#
# control had thirty attempts and keel-site had exactly one, immediately after
# — an asymmetry nobody chose, and one that held only for as long as Next.js
# happened to boot faster than the control plane. It stopped holding the day
# the landing page started fetching from the control plane during its first
# render: same container, same second, one shot, and the deploy failed on a
# site that came up fine moments later.
wait_for() {
	local name=$1 url=$2
	for _ in $(seq 1 30); do
		if docker exec keel-caddy wget -qO- --timeout=5 "$url" >/dev/null 2>&1; then
			echo "    $name OK"
			return 0
		fi
		sleep 2
	done
	echo "    $name JAVOB BERMADI" >&2
	# The useful sentence is the container's, not ours.
	docker logs --tail 30 "$name" 2>&1 | sed 's/^/      /' >&2
	return 1
}

wait_for keel-control http://keel-control:9000/health || exit 1
wait_for keel-site http://keel-site:3100/ || exit 1
# Every tenant site goes through the cache now, so it is the one new single
# point of failure this deploy introduced. Checked before the deploy is called
# a success, and checked on its own endpoint rather than through a render — the
# question here is "is nginx up", not "is Next.js up".
wait_for keel-pagecache http://keel-pagecache:3000/_cache_health || exit 1

down=$("${COMPOSE[@]}" ps --status exited --status dead -q | wc -l)
[ "$down" = 0 ] || { echo "    $down konteyner ishlamayapti" >&2; "${COMPOSE[@]}" ps; exit 1; }

echo "==> deploy tugadi: $(git --no-pager log --oneline -1)"

# Tenant containers are rolled forward by the control plane, not from here.
#
# Already-running tenants keep the image they were started with, so a backend
# change reaches nobody until each container is replaced. That is done ~90s
# after the control container comes up (`RolloutOnBoot`), one tenant at a time,
# each waiting on its own /health before the next is touched.
#
# Deliberately not this script's job: rolling fifty restaurants takes minutes,
# and a deploy that fails because the twelfth restaurant is slow would be a
# worse failure than the one it fixes. Progress and any tenant that did not
# come up are in the console; `ROLLOUT_ON_BOOT=0` turns it off.
