# Bootstrap only.
#
# The real configuration is generated by the control plane from the tenant list
# and pushed to the admin API (see control/internal/caddy). This file exists so
# that Caddy can start at all, and — the part that matters — so the admin API is
# listening on the container network before anything tries to push to it.
#
# Caddy re-reads this file on restart, which is why the control plane syncs the
# edge once at boot as well: without that, a reboot would leave every customer
# served by the two lines below until somebody happened to edit a tenant.
{
	admin 0.0.0.0:2019
}

# Answers the load balancer and anyone who arrives before the first sync, and
# says something truthful rather than a Caddy default page.
:80 {
	respond "Keel: sozlanmoqda" 503
}
