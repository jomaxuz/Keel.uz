<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- ⚠️ Android 12 draws a splash whether we configure one or not — from the
         launcher icon on the window background — so the choice is never "splash
         or none", it is "ours or whatever it guesses". Below 12 the androidx
         library draws the same thing, which is what stops the app looking like
         two different products depending on the phone. -->
    <style name="Theme.KeelTeam.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/keel_navy</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="postSplashScreenTheme">@style/Theme.KeelTeam</item>
    </style>

    <style name="Theme.KeelTeam" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/keel_navy</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <!-- ⚠️ The app draws both schemes itself. A phone-wide "dark mode for
             all apps" (MIUI, One UI) otherwise inverts some of what Compose
             draws and not the rest: white ink on a still-cream panel. -->
        <item name="android:forceDarkAllowed" tools:targetApi="q">false</item>
    </style>
</resources>
