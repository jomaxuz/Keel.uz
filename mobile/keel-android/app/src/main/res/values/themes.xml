<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- The system splash: the mark and the word "Keel" on navy, drawn before
         any of this application's code runs. Below Android 12 the androidx
         library draws the same thing, so the first second looks the same on
         every phone in the building. -->
    <style name="Theme.Keel.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/keel_navy</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="postSplashScreenTheme">@style/Theme.Keel</item>
    </style>

    <style name="Theme.Keel" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/keel_navy</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <!-- "Dark mode for all apps" (MIUI, One UI) otherwise inverts part of
             what Compose draws and not the rest. -->
        <item name="android:forceDarkAllowed" tools:targetApi="q">false</item>
    </style>
</resources>
