<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- ⚠️ **Coarse only, and asked for at the map, never at launch.** "Where
         am I" saves a delivery address one drag; asked before anybody has said
         they want delivery it is a permission most people refuse once and for
         all, and the refusal costs the feature it was for. Coarse is enough to
         centre a map somebody is about to drag anyway. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- ⚠️ **Asked for after a sign-in, never at launch.** Android 13 puts a
         yes/no question with no context in front of somebody who has not ordered
         anything yet; most people say no once and permanently, and the refusal
         takes the order updates with it. See push/Push.kt. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".KeelGuestApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.KeelGuest"
        android:usesCleartextTraffic="false">

        <!-- Written by the build from brand.properties — see app/build.gradle.kts. -->
        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="${mapsApiKey}" />

        <!-- ⚠️ **The channel the phone actually creates** (push/Push.kt), named
             here so a message that arrives before any Kotlin has run still lands
             somewhere ranked. A channel that was never created arrives silent,
             which looks exactly like a notification nobody sent. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="orders" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_notification" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.KeelGuest.Splash"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- ⚠️ Without it a push that arrives while the app is open is dropped:
             the system draws only the ones that arrive in the background. -->
        <service
            android:name=".push.OrderMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
    </application>
</manifest>
