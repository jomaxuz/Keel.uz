      },
      "predictiveBackGestureEnabled": false,
      "package": "uz.keel.waiter"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store"
    ],
    "scheme": "keelwaiter",
    "extra": {
      "eas": {
        "projectId": "e5c8613f-b366-4a79-bc71-1b836fc5f4cc"
