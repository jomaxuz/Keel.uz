<?xml version="1.0" encoding="utf-8"?>
<!-- The brand's own navy behind the mark, as the Expo build had it. The
     monochrome layer is what Android 13+ themed icons use; without it the
     launcher falls back to a flat grey square. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/keel_navy" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
    <monochrome android:drawable="@drawable/ic_launcher_monochrome" />
</adaptive-icon>
