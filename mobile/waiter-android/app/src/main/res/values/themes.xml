<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The splash, and the only theme the launcher ever sees.
         ⚠️ **`Theme.SplashScreen` from androidx, not `android:windowBackground`
         alone.** Android 12 draws a system splash whether we configure one or
         not — from the launcher icon on the window background — so the choice is
         never "splash or no splash", it is "ours or whatever it guesses". Below
         12 the same library draws the same thing, which is what stops the app
         looking like two different products depending on the phone.
         ⚠️ The activity is declared with **this** theme and swaps to the app's
         at runtime (`postSplashScreenTheme`). Declaring the app theme and
         calling `installSplashScreen()` gives a frame of the wrong background. -->
    <style name="Theme.KeelWaiter.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/keel_navy</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="postSplashScreenTheme">@style/Theme.KeelWaiter</item>
    </style>

    <!-- Compose paints everything; this exists so the window behind it is the
         brand's own colour rather than white. ⚠️ A white flash between the
         splash and the first frame is what reads as two applications starting. -->
    <style name="Theme.KeelWaiter" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/keel_navy</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
