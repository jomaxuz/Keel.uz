<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- ⚠️ Android 13+. Asked after signing in, never at launch: a prompt on the
         first screen is answered before anybody knows what the app is for. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- ⚠️ **Declared, or the dialler button silently does nothing.** Android 11+
         hides other applications unless a query says what this one needs to
         reach, and `ACTION_DIAL` resolves to nothing without it — a button that
         looks fine and never opens anything. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.DIAL" />
            <data android:scheme="tel" />
        </intent>
    </queries>

    <application
        android:name=".KeelOwnerApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="false"
        android:theme="@style/Theme.KeelOwner.Splash">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.KeelOwner.Splash"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- ⚠️ Registered here rather than created at runtime so a notification
             arriving before the app has ever run still lands in the right
             channel. A message sent to a channel the phone never created is
             dropped silently — a working registration and nothing heard. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="owner" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_color"
            android:resource="@color/keel_orange" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_notification" />

        <service
            android:name=".push.OwnerMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
    </application>
</manifest>
