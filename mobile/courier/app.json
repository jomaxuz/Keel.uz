{
  "expo": {
    "name": "Keel Courier",
    "slug": "keel-courier",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "uz.keel.courier",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Smena davomida joylashuv restoranga ko'rinadi va \"yetkazildi\" tugmasi shu bilan ochiladi."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#000B1C",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "uz.keel.courier"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#000B1C",
          "imageWidth": 220
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "enableProguardInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true
          }
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Smena davomida joylashuv restoranga ko'rinadi va \"yetkazildi\" tugmasi shu bilan ochiladi."
        }
      ],
      "expo-font"
    ],
    "scheme": "keelcourier",
    "owner": "josephnv7s-team",
    "backgroundColor": "#000B1C"
  }
}
