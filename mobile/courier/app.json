{
  "expo": {
    "name": "Keel Courier",
    "slug": "keel-courier",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "uz.keel.courier",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Smena davomida joylashuv restoranga ko'rinadi va \"yetkazildi\" tugmasi shu bilan ochiladi.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Telefon cho'ntakda bo'lganda ham joylashuv yuboriladi — aks holda \"yetkazildi\" tugmasi eshik oldida ochilmaydi.",
        "UIBackgroundModes": [
          "location",
          "remote-notification"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#000B1C",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "uz.keel.courier",
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_LOCATION",
        "POST_NOTIFICATIONS",
        "WAKE_LOCK"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#000B1C",
          "imageWidth": 220
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "enableProguardInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "enableMinifyInReleaseBuilds": true
          }
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Smena davomida joylashuv restoranga ko'rinadi va \"yetkazildi\" tugmasi shu bilan ochiladi.",
          "locationAlwaysAndWhenInUsePermission": "Telefon cho'ntakda bo'lganda ham joylashuv yuboriladi — aks holda \"yetkazildi\" tugmasi eshik oldida ochilmaydi.",
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      "expo-font",
      [
        "expo-notifications",
        {
          "icon": "./assets/android-icon-monochrome.png",
          "color": "#e2590d",
          "defaultChannel": "delivery"
        }
      ],
      "expo-task-manager"
    ],
    "scheme": "keelcourier",
    "owner": "josephnv7s-team",
    "backgroundColor": "#000B1C",
    "extra": {
      "eas": {
        "projectId": "7579dfc1-38bd-4d14-a598-4d4a8995ed59"
      }
    }
  }
}
