# Secrets — never commit real environment files. The *.example templates next
# to them ARE committed; note the un-ignore has to be `*.example`, because
# `.env.*.example` needs two dots and would leave `backend/.env.example` out.
.env
.env.*
!*.example

# Dependencies and build output
node_modules/
.next/
out/
build/
dist/
*.tsbuildinfo
next-env.d.ts

# Go
*.exe
*.test
*.out
/backend/server
/backend/adminreset
/backend/seedmenu
/backend/demodata

# Uploaded images live on the server's disk (a docker volume in production),
# not in the repo — see CLAUDE.md §2. The demo menu's images are embedded in
# the Go binary instead (internal/seed/assets).
/backend/uploads/

# Local tooling / OS / editor noise
.DS_Store
Thumbs.db
*.swp
*.log
.idea/
.vscode/

# The deploy lock, taken at /opt/keel/.deploy.lock on the server. Ignored so a
# checkout that has deployed does not report itself dirty — and so nobody
# "tidies it away" into the repository.
.deploy.lock

# Agent skills installed into this checkout (`npx skills add`, plugin
# marketplaces). ⚠️ **Ignored rather than committed**, because they are
# somebody's tooling and not part of the product: they arrive with megabytes of
# artwork, they update on their own schedule, and a skill that runs with full
# agent permissions is not something to hand every future clone of this
# repository without a decision. A skill the team genuinely wants shared gets
# added on purpose, without the images.
/.claude/skills/
/.agents/
/skills-lock.json
