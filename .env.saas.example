# Keel — the multi-tenant deployment's environment.
#
# Copy to `.env` next to docker-compose.saas.yml and fill in. Compose reads
# `.env` automatically; nothing here belongs in the repository.
#
#   cp .env.saas.example .env && nano .env

# Every day boundary in this system — a billing period, a staff shift, a
# demo's last day — is a local calendar day. Leave this alone unless the
# business genuinely moves.
TZ=Asia/Tashkent

# ---- Keel console ----

# Signs the dashboard's own tokens. Must differ from every tenant's secret,
# which the control plane generates per customer anyway.
#   openssl rand -hex 32
CONTROL_JWT_SECRET=

# The first console account, created only when no account exists yet. Changing
# these later does NOT reset the password — that is deliberate, so a redeploy
# cannot quietly put it back to what is written in a file.
KEEL_ADMIN_USERNAME=keel
KEEL_ADMIN_PASSWORD=

# ---- Domains and billing ----

# Every new customer gets <slug>.BASE_DOMAIN for free.
BASE_DOMAIN=keel.uz

# So'm per order, for customers created without an explicit price. Stored per
# tenant at creation, so raising this later never re-prices an existing one.
PRICE_PER_ORDER=800

# The volume ladder: "upTo:price" bands, last one upTo 0 for "no limit".
#
# Read as "whichever band is cheapest": a customer may enter a band early by
# paying its full order count, so the average lands exactly on the published
# band rate. A marginal ladder cannot do that — it always averages above the
# last band it touched, which is how a lower headline rate loses to a higher one.
#
# Set 20% under the competitor's published bands (1 000 / 700 / 500), plus a
# fourth band only a chain reaches. Empty switches tiers off and bills flat.
PRICE_TIERS=3000:800,15000:560,50000:400,0:300

# The least a customer is billed for a period they actually used, in so'm.
#
# The other end of the volume ladder: tiers stop the largest invoice from
# inviting a negotiation, this stops the smallest customer from costing more in
# support than they pay. A restaurant doing five orders a day bills ~150 000 a
# month and needs the same calls, menu fixes and hand-holding as one doing four
# hundred.
#
# 0 = off, and that is the default on purpose: a floor changes what real
# customers owe, and that must be a decision rather than the side effect of a
# deploy. A period with **no** orders is never charged, whatever this is set to.
# Per-customer floors are set on the customer's card and win over this.
MIN_MONTHLY=0
# Watermarksiz sayt — oyiga qancha (so'm). 0 = umuman hisoblanmaydi.
WATERMARK_PRICE=3000000

# keel.uz'ni Google Search Console va Yandex Webmaster'ga tasdiqlash.
#
# Konsolda "HTML tegi" usulini tanlang va bergan qatorini shu yerga qo'ying —
# butun `<meta ...>` tegini emas, faqat `content` qiymatini. Bo'sh qoldirilsa
# teg umuman chizilmaydi, va bu to'g'ri: bo'sh teg ikkala konsol uchun ham
# "teg bor, lekin noto'g'ri" degani.
#
# Tenant saytlari uchun bu boshqacha — u yerda har restoran o'z kodini panelda
# kiritadi (sozlamalar → "Qidiruv tizimlari"), chunki har biri o'z domenida.
GOOGLE_SITE_VERIFICATION=
YANDEX_VERIFICATION=

# Meta (Facebook) pikseli — FAQAT keel.uz uchun (o'z reklamamizni o'lchash).
# Events Manager → Ma'lumot manbalari → Piksel dan olinadigan 15-16 raqamli ID.
#
# ⚠️ Mijozlar saytlariga bu berilmaydi va berilmasligi kerak: restorandan
# ovqat buyurtma qilgan mehmon bizning reklama hisobimiz tomonidan
# o'lchanishga rozilik bermagan, restoran ham o'z mijozlarini bizga
# topshirmagan.
# ⚠️ Bo'sh = piksel yo'q. Bu holatda cookie oynasi eski holiga qaytadi
# ("o'chiradigan narsa yo'q") — chunki o'shanda bu rost bo'ladi.
# Piksel faqat tashrifchi rozilik bergandan keyin yuklanadi.
META_PIXEL_ID=

# Meta'da domenni tasdiqlash kodi (Настройки компании -> Домены -> "Добавьте
# метатег"). Faqat `content="..."` ichidagi qiymat, butun teg emas.
# Bo'sh = teg umuman chizilmaydi (Google/Yandex kodlari bilan bir qoida:
# bo'sh teg "teg bor, lekin noto'g'ri" degani).
META_DOMAIN_VERIFICATION=

TRIAL_DAYS=14

# Where Let's Encrypt sends expiry warnings. A real, read mailbox: it is the
# only warning you get before a certificate lapses.
CADDY_EMAIL=

# Host directory holding every tenant's uploaded images, one folder per slug.
# On the host, not in a container — the Docker daemon resolves these mounts.
UPLOADS_ROOT=/srv/keel/tenants

# ---- Passed through to every tenant container ----

# `demo` returns the SMS code in the API response instead of sending it. That
# is fine while nobody real is logging in, and a hole the moment somebody is.
SMS_PROVIDER=demo
SMS_FROM=
ESKIZ_EMAIL=
ESKIZ_PASSWORD=

# 2GIS MapGL key (free, dev.2gis.com). One key for every tenant, because the
# frontend is one build serving all of them — so if the key is domain-locked,
# every customer domain has to be on its allow-list.
NEXT_PUBLIC_MAP_API_KEY=

# ---- Windows kassa dasturi ----
# keel.uz/download tugmasi shu manzilga olib boradi.
# ⚠️ Har doim "latest" havolasi, versiyali fayl emas: manzil deploy'ga
# yoziladi, versiyali bo'lsa har reliz saytni qayta deploy qilishni talab
# qiladi — va bir kun unutiladi, sayt esa oylab eski dasturni tarqatadi.
# Bo'sh qoldirilsa sahifa "hali tayyor emas" deydi (buzuq havoladan yaxshi).
TILL_DOWNLOAD_URL=https://github.com/jomaxuz/keel-releases/releases/latest/download/keel.exe
