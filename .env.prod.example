# Server timezone. Staff attendance is filed by local calendar day, so a
# wrong value shifts every shift onto the wrong date.
TZ=Asia/Tashkent

# Production environment for docker-compose.prod.yml.
# Copy to `.env` on the server and fill in real values (never commit `.env`).

# Domain the site is served from (no protocol, no trailing slash).
DOMAIN=example.uz

# Long random string — invalidates all admin sessions when changed.
# Generate with: openssl rand -hex 32
JWT_SECRET=

# First admin user, created on the first run only. Change the password after
# the first login (the panel forces it).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# 2GIS MapGL key — free at https://dev.2gis.com
NEXT_PUBLIC_MAP_API_KEY=

# Only needed if the frontend is hosted on a different origin (e.g. Vercel).
# Comma-separated list of allowed browser origins.
# CORS_ORIGINS=https://example.uz,https://www.example.uz

# SMS login. Keep "demo" until an SMS contract is in place: in demo mode no SMS
# is sent and the code is returned by the API (fine for testing, NOT for prod).
SMS_PROVIDER=demo
SMS_FROM=4546
ESKIZ_EMAIL=
ESKIZ_PASSWORD=
PLAYMOBILE_LOGIN=
PLAYMOBILE_PASSWORD=
