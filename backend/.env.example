# Server timezone. Staff attendance (shift dates) is filed by local
# calendar day, so a wrong value puts shifts on the wrong date.
TZ=Asia/Tashkent
PORT=8080
MONGO_URI=mongodb://localhost:27017
MONGO_DB=restaurant
# The server refuses to start with this unset or left at a default.
# Generate one: openssl rand -hex 32
JWT_SECRET=dev-only-change-me-0123456789abcdef
UPLOAD_DIR=./uploads
PUBLIC_BASE_URL=http://localhost:8080
CORS_ORIGINS=http://localhost:3000
# Initial admin (created on first run if no admin exists)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# Telegram Login (per-restaurant bot from @BotFather)
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# ---- SMS login (phone + one-time code) ----
#
# Provayder odatda ADMIN PANELDA tanlanadi (Sozlamalar → SMS provayderi).
# Bu yerdagi qiymatlar faqat panel hali ochilmagan install uchun zaxira.
#
# demo       — SMS yuborilmaydi
# eskiz      — notify.eskiz.uz (ESKIZ_EMAIL + ESKIZ_PASSWORD)
# playmobile — playmobile.uz broker-api (PLAYMOBILE_LOGIN + PLAYMOBILE_PASSWORD)
# getsms     — getsms.uz
# onesignal  — onesignal.com
SMS_PROVIDER=demo

# ⚠️ FAQAT LOKAL ISHLAB CHIQISH UCHUN. Yoqilganda bir martalik kod API
# javobida qaytariladi — ya'ni shlyuzsiz ham loginni sinab ko'rish mumkin.
#
# Jonli serverda BUNI HECH QACHON YOQMANG: kod javobda ko'rinsa, istalgan odam
# istalgan raqam uchun kod so'rab, uni JSON'dan o'qib, o'sha odam bo'lib kira
# oladi. O'chirilgan holatda shlyuz sozlanmagan bo'lsa login umuman ishlamaydi
# — bu to'g'ri xatti-harakat.
SMS_DEMO_EXPOSE_CODE=1
SMS_FROM=4546
ESKIZ_EMAIL=
ESKIZ_PASSWORD=
# PLAYMOBILE_URL=http://91.204.239.44/broker-api/send
PLAYMOBILE_LOGIN=
PLAYMOBILE_PASSWORD=
