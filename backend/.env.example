# Server timezone. Staff attendance (shift dates) is filed by local
# calendar day, so a wrong value puts shifts on the wrong date.
TZ=Asia/Tashkent
PORT=8080
MONGO_URI=mongodb://localhost:27017
MONGO_DB=restaurant
JWT_SECRET=change-me-in-production
UPLOAD_DIR=./uploads
PUBLIC_BASE_URL=http://localhost:8080
CORS_ORIGINS=http://localhost:3000
# Initial admin (created on first run if no admin exists)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# Telegram Login (per-restaurant bot from @BotFather)
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# ---- SMS login (phone + one-time code) ----
# demo       — SMS yuborilmaydi, kod API javobida qaytadi (dev uchun)
# eskiz      — notify.eskiz.uz (ESKIZ_EMAIL + ESKIZ_PASSWORD)
# playmobile — playmobile.uz broker-api (PLAYMOBILE_LOGIN + PLAYMOBILE_PASSWORD)
SMS_PROVIDER=demo
SMS_FROM=4546
ESKIZ_EMAIL=
ESKIZ_PASSWORD=
# PLAYMOBILE_URL=http://91.204.239.44/broker-api/send
PLAYMOBILE_LOGIN=
PLAYMOBILE_PASSWORD=
